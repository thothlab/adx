{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADX",
  "version": "1.0.5",
  "identifier": "tech.thothlab.adx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ADX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: adx: http://adx.localhost; frame-src blob:; object-src blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzRTIxMUU1MTk0MURBMDUKUldRRjJrRVo1UkhpTXg5MEZQR1dOVmg0NndLaCsveWJHN1pxbTI5VmFpZHh0S0I5SUVDOHJsWmcK",
      "endpoints": ["https://github.com/thothlab/adx/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Файлы Android-устройства по USB",
    "longDescription": "ADX - Android Device eXplorer: просмотр файлов Android-устройства по USB через MTP, передача в обе стороны, стабильная сессия.",
    "copyright": "Apache-2.0",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
